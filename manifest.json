{
  "manifest_version": 3,
  "name": "Claude Usage Monitor",
  "version": "2.0.0",
  "description": "Track Claude.ai plan usage with history, burn-rate warnings, and menu bar support",
  "permissions": ["storage", "notifications", "alarms", "tabs", "offscreen"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:39571/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["https://claude.ai/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Usage Monitor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
