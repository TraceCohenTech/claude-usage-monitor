{
  "manifest_version": 3,
  "name": "Claude Usage Monitor",
  "short_name": "Claude Usage",
  "version": "2.2.0",
  "description": "Never lose work mid-prompt. Live Claude.ai usage bars, burn-rate alerts & runway. History heatmap. 100% local — no data ever sent.",
  "author": "Trace Cohen",
  "homepage_url": "https://valueaddvc.com/claude-monitor",
  "permissions": ["storage", "notifications", "alarms", "tabs", "offscreen"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:39571/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["https://claude.ai/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Usage Monitor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
